# ============================================================
# 墨笔 · 小说创作 Agent — 部署配置示例
# 复制为 .env 使用。部署级配置只来自环境变量;
# LLM 模型配置(provider/model/api_key 等)在 Web 设置页热改。
# ============================================================

# --- 运行环境 ---
NOVEL_AGENT_ENV=prod                     # dev | prod(prod 时隐藏文档、开启严谨日志)

# --- 数据目录 ---
NOVEL_AGENT_DATA_DIR=./data              # 项目与配置的存储目录(旧变量 NOVEL_AGENT_DATA 仍兼容)

# --- 访问鉴权(生产强烈建议设置)---
NOVEL_AGENT_AUTH_KEY=                    # 设置后所有 /api/* 需携带请求头 X-API-Key
NOVEL_AGENT_CORS_ORIGINS=                # 允许跨域的来源,逗号分隔,如 https://example.com;留空则不允许跨域

# --- 限流(内存滑动窗口,仅对 /api/* 生效)---
NOVEL_AGENT_RATE_LIMIT=240/60            # 格式:请求数/窗口秒;置空禁用

# --- 请求体大小上限 ---
NOVEL_AGENT_MAX_BODY_MB=2                # 超过该大小的请求体直接返回 413(防超大请求 DoS)

# --- 日志 ---
NOVEL_AGENT_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
NOVEL_AGENT_LOG_JSON=false               # true 时输出 JSON 日志(容器/采集器友好)

# --- LLM 调用治理 ---
NOVEL_AGENT_LLM_CONCURRENCY=4            # 全局并发生成上限
NOVEL_AGENT_LLM_TIMEOUT=300              # 单次 LLM 流式调用超时(秒)
NOVEL_AGENT_LLM_MAX_RETRIES=2            # 连接失败时 SDK 内部重试次数

# --- LLM 模型(也可在 Web 设置页配置,环境变量优先)---
# NOVEL_AGENT_PROVIDER=openai             # openai | anthropic | mock
# NOVEL_AGENT_MODEL=deepseek-chat
# NOVEL_AGENT_BASE_URL=https://api.deepseek.com/v1
# NOVEL_AGENT_API_KEY=sk-...
# NOVEL_AGENT_CHAPTER_WORDS=2500
# NOVEL_AGENT_TEMPERATURE=0.8
