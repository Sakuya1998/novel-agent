# LLM Provider: openai / anthropic
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o
TEMPERATURE=0.7
MAX_TOKENS=4000

# API Keys(必填其一)
OPENAI_API_KEY=your-api-key-here
ANTHROPIC_API_KEY=

# 嵌入模型(向量记忆)
EMBEDDING_MODEL=text-embedding-3-small

# 存储路径(可选,默认 memory/ 下)
# CHROMA_PERSIST_DIR=./memory/chroma_db
# SQLITE_DB_PATH=./memory/novels.db
# CHECKPOINT_DB_PATH=./memory/checkpoints.db

# 生成控制
MAX_CHAPTER_WORDS=6000
TOTAL_CHAPTERS=10
MAX_REVISION_ATTEMPTS=3
DEFAULT_STYLE=jin_yong
