# 可选的模型环境回退配置
# 工作台保存的模型服务与模型分工优先；仅在尚未保存模型路由时，CLI/API 才读取以下配置。
# 环境回退支持 OpenAI / Anthropic 聊天模型，嵌入模型使用 OpenAI。
APP_ENVIRONMENT=development
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o
TEMPERATURE=0.7
MAX_TOKENS=4000
MODEL_TIMEOUT_SECONDS=120
MODEL_RETRY_ATTEMPTS=2
MODEL_RETRY_BASE_DELAY=0.5
MAX_NOVEL_TOKENS=0
RUN_JOB_LEASE_SECONDS=60
RUN_JOB_HEARTBEAT_SECONDS=15

# 仅使用环境回退时按需填写；工作台录入的 API Key 不会写入 .env
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 环境回退嵌入模型(向量记忆)
EMBEDDING_MODEL=text-embedding-3-small

# 存储路径(可选,默认 memory/ 下)
# CHROMA_PERSIST_DIR=./memory/chroma_db
# SQLITE_DB_PATH=./memory/novels.db
# CHECKPOINT_DB_PATH=./memory/checkpoints.db
# MODEL_SECRET_KEY_PATH=./data/model-settings.key
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_ENABLED=false
AUTH_SESSION_HOURS=720
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60
SENSITIVE_RATE_LIMIT_MAX_ATTEMPTS=30
MAX_IMPORT_BYTES=52428800
BACKGROUND_TRANSFER_BYTES=10485760
RUNTIME_BACKUP_DIR=./data/runtime-backups
BACKUP_RETENTION_COUNT=7

# 生成控制
MAX_CHAPTER_WORDS=6000
TOTAL_CHAPTERS=10
MAX_REVISION_ATTEMPTS=3
QUALITY_GATE_THRESHOLD=70
DEFAULT_STYLE=jin_yong
