# 复制为 .env 后按部署环境修改；生产模式会拒绝匿名认证。
APP_ENVIRONMENT=production
AUTH_ENABLED=true
AUTH_SESSION_HOURS=720
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60
SENSITIVE_RATE_LIMIT_MAX_ATTEMPTS=30

# 生产环境建议显式设置前端来源；同源 Nginx 部署可填写实际访问 origin。
FRONTEND_ORIGINS=https://novel.example.com
RUNTIME_BACKUP_DIR=./data/runtime-backups
BACKUP_RETENTION_COUNT=7

# 可选的模型环境回退配置；也可以在工作台中保存模型路由。
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
